<?xml version="1.0" encoding="utf-8"?>

<!-- ReSharper disable Xaml.PossibleNullReferenceException -->

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MyHotsInfo.Controls"
             xmlns:pages="clr-namespace:MyHotsInfo.Pages"
             xmlns:utils="clr-namespace:MyHotsInfo.Utils"
             xmlns:xaml="clr-namespace:Microsoft.Maui.Controls.Xaml;assembly=Microsoft.Maui.Controls.Xaml"
             xmlns:models="clr-namespace:MyReplayLibrary.Data.Models;assembly=MyReplayLibrary"
             x:DataType="pages:ReplayListViewModel"
             x:Class="MyHotsInfo.Pages.ReplayList">
    <ContentPage.BindingContext>
        <pages:ReplayListViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <utils:NullToBooleanConverter x:Key="NullToBooleanConverter" />
            <utils:ReplayResultConverter x:Key="ReplayResultConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*" Padding="30,0">
        <Button Clicked="Refresh_Click"
            Text="Refresh" HorizontalOptions="Center"
            SemanticProperties.HeadingLevel="Level1" />

        <Grid RowDefinitions="*" ColumnDefinitions="*,*" Grid.Row="1">
            <CollectionView
                x:Name="ReplaysView"
                VerticalScrollBarVisibility="Always"
                ItemsSource="{Binding Replays}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedReplay, Mode=TwoWay}">

                <CollectionView.Header>
                    <Grid RowDefinitions="Auto" ColumnDefinitions="24,*,*,*">
                        <Label Text="Date" Grid.Column="1" />
                        <Label Text="Map" Grid.Column="2" />
                        <Label Text="Length" Grid.Column="3" />
                    </Grid>
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ReplayEntry">
                        <Grid RowDefinitions="Auto" ColumnDefinitions="24,*,*,*">
                            <!-- A smiley for a win, a frown for a loss; the face and eyes are shared. -->
                            <Path WidthRequest="16" HeightRequest="16" VerticalOptions="Center"
                                  Stroke="#4CC24A" StrokeThickness="1.5" StrokeLineCap="Round"
                                  Data="M 1,8 A 7,7 0 1 1 15,8 A 7,7 0 1 1 1,8 M 5.5,5.5 L 5.5,6.5 M 10.5,5.5 L 10.5,6.5 M 5,10 Q 8,13 11,10"
                                  IsVisible="{Binding ., Converter={StaticResource ReplayResultConverter}, ConverterParameter=Victory}"
                                  ToolTipProperties.Text="Victory" />
                            <Path WidthRequest="16" HeightRequest="16" VerticalOptions="Center"
                                  Stroke="#E5484D" StrokeThickness="1.5" StrokeLineCap="Round"
                                  Data="M 1,8 A 7,7 0 1 1 15,8 A 7,7 0 1 1 1,8 M 5.5,5.5 L 5.5,6.5 M 10.5,5.5 L 10.5,6.5 M 5,11.5 Q 8,8.5 11,11.5"
                                  IsVisible="{Binding ., Converter={StaticResource ReplayResultConverter}, ConverterParameter=Defeat}"
                                  ToolTipProperties.Text="Defeat" />
                            <Label Text="{Binding TimestampReplay}" Grid.Column="1" />
                            <Label Text="{Binding MapId}" Grid.Column="2" />
                            <Label Text="{Binding ReplayLength}" Grid.Column="3" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <!-- The game's score screen, scaled to fit, with a button to open it full size. -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" Padding="12,6,12,12"
                  IsVisible="{Binding SelectedReplay, Converter={StaticResource NullToBooleanConverter}}">
                <Grid.Background>
                    <RadialGradientBrush Center="0.5,0.45" Radius="0.9">
                        <GradientStop Color="#2A1763" Offset="0" />
                        <GradientStop Color="#120A2C" Offset="0.7" />
                        <GradientStop Color="#0A0619" Offset="1" />
                    </RadialGradientBrush>
                </Grid.Background>

                <Grid HorizontalOptions="End" Padding="6" BackgroundColor="Transparent"
                      ToolTipProperties.Text="Open the summary">
                    <Path WidthRequest="16" HeightRequest="16"
                          Stroke="#B8AEE8" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                          Data="M 9,7 L 15,1 M 10,1 L 15,1 L 15,6 M 7,9 L 1,15 M 1,10 L 1,15 L 6,15" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="FullscreenTapped" />
                    </Grid.GestureRecognizers>
                </Grid>

                <controls:ScaleToFit Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Start">
                    <controls:ReplaySummaryView BindingContext="{Binding Summary}" PlayerTapped="PlayerTapped" />
                </controls:ScaleToFit>
            </Grid>
        </Grid>
    </Grid>

</ContentPage>
