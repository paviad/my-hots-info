<?xml version="1.0" encoding="utf-8"?>

<!-- ReSharper disable Xaml.PossibleNullReferenceException -->

<!-- Every hero's talents as of a scraped build, marked with what changed since the build before. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:MyHotsInfo.Pages"
             xmlns:utils="clr-namespace:MyHotsInfo.Utils"
             x:DataType="pages:HeroBrowserViewModel"
             x:Class="MyHotsInfo.Pages.HeroBrowser"
             Title="Heroes">
    <ContentPage.Resources>
        <ResourceDictionary>
            <utils:HeroToImageConverter x:Key="HeroToImageConverter" />
            <utils:NullToBooleanConverter x:Key="NullToBooleanConverter" />

            <Style x:Key="Dim" TargetType="Label">
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
            </Style>

            <Style x:Key="TabLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Padding" Value="0,2,0,6" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
            </Style>

            <Style x:Key="TabUnderline" TargetType="BoxView">
                <Setter Property="HeightRequest" Value="2" />
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="Color"
                        Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
            </Style>

            <!-- A map or mode to count; tap to pick it or drop it. Not selectable text: the tap has to reach it. -->
            <DataTemplate x:Key="FilterChip" x:DataType="pages:StatsFilter">
                <Border Padding="10,3" Margin="0,0,6,6" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}"
                        BackgroundColor="Transparent" utils:Selectable.Disabled="True">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Label}" FontSize="13">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="260,*" ColumnSpacing="30" Padding="30,12,30,0">
        <!-- Build, search and the heroes -->
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
            <Picker Title="Build" ItemsSource="{Binding BuildLabels}" SelectedIndex="{Binding SelectedBuildIndex}" />
            <Entry Grid.Row="1" Placeholder="Search heroes" Text="{Binding SearchText}"
                   ClearButtonVisibility="WhileEditing" />
            <HorizontalStackLayout Grid.Row="2" IsVisible="{Binding HasPreviousBuild}">
                <CheckBox IsChecked="{Binding ChangedOnly}" />
                <Label Text="Changed in this build" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>

            <CollectionView Grid.Row="3"
                            ItemsSource="{Binding Heroes}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedHero, Mode=TwoWay}"
                            VerticalScrollBarVisibility="Always">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="pages:HeroBrowserHero">
                        <!-- Not selectable text: a click on it has to select the hero. -->
                        <Grid ColumnDefinitions="36,*,Auto" Padding="4,3,10,3" ColumnSpacing="8"
                              utils:Selectable.Disabled="True">
                            <Image Source="{Binding Id, Converter={StaticResource HeroToImageConverter}, ConverterParameter='circle'}"
                                   HeightRequest="28" WidthRequest="28" />
                            <Label Grid.Column="1" Text="{Binding Id}" VerticalTextAlignment="Center" />
                            <Border Grid.Column="2" IsVisible="{Binding IsChanged}" VerticalOptions="Center"
                                    StrokeThickness="0" BackgroundColor="#E8B04A" Padding="7,0"
                                    StrokeShape="RoundRectangle 8"
                                    ToolTipProperties.Text="Talents changed since the build before">
                                <Label Text="{Binding ChangeLabel}" FontSize="11" FontFamily="OpenSansSemibold"
                                       TextColor="#1A1200" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- The hero: its talents tier by tier, or how my games with and against it went -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="12">
            <HorizontalStackLayout Spacing="14">
                <Image Source="{Binding HeroName, Converter={StaticResource HeroToImageConverter}}"
                       IsVisible="{Binding HeroName, Converter={StaticResource NullToBooleanConverter}}"
                       HeightRequest="64" WidthRequest="64" />
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="{Binding HeroName}" FontSize="24" FontFamily="OpenSansSemibold" />
                    <Label Text="{Binding HeroSummary}" Style="{StaticResource Dim}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Talents | Statistics -->
            <HorizontalStackLayout Grid.Row="1" Spacing="18">
                <Grid>
                    <Label Text="Talents" Style="{StaticResource TabLabel}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding ShowTalents}" Value="True">
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                            </DataTrigger>
                        </Label.Triggers>
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTalentsTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <BoxView Style="{StaticResource TabUnderline}" IsVisible="{Binding ShowTalents}" />
                </Grid>
                <Grid>
                    <Label Text="Statistics" Style="{StaticResource TabLabel}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding ShowStatistics}" Value="True">
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                            </DataTrigger>
                        </Label.Triggers>
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStatisticsTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <BoxView Style="{StaticResource TabUnderline}" IsVisible="{Binding ShowStatistics}" />
                </Grid>
            </HorizontalStackLayout>

            <CollectionView Grid.Row="2" ItemsSource="{Binding Tiers}" VerticalScrollBarVisibility="Always"
                            IsVisible="{Binding ShowTalents}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="pages:HeroBrowserTier">
                        <VerticalStackLayout Margin="0,0,16,18">
                            <Label Text="{Binding Title}" FontSize="16" FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkText}}" />
                            <BoxView HeightRequest="1" Color="Gray" Margin="0,2,0,4" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Talents}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="pages:HeroBrowserTalent">
                                        <Grid ColumnDefinitions="48,*" ColumnSpacing="12" Padding="0,6"
                                              Opacity="{Binding Opacity}">
                                            <Border WidthRequest="48" HeightRequest="48" VerticalOptions="Start"
                                                    StrokeThickness="1" Stroke="#A9A2D8" BackgroundColor="#1A0F33"
                                                    Padding="0">
                                                <Image Source="{Binding Image}" Aspect="AspectFill" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                                                    <Border IsVisible="{Binding Badge, Converter={StaticResource NullToBooleanConverter}}"
                                                            VerticalOptions="Center" StrokeThickness="1"
                                                            Stroke="{Binding BadgeColor}" Padding="6,0"
                                                            StrokeShape="RoundRectangle 4">
                                                        <Label Text="{Binding Badge}" FontSize="11"
                                                               TextColor="{Binding BadgeColor}" />
                                                    </Border>
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding Description}" LineBreakMode="WordWrap" />
                                                <Label Text="{Binding Was}" LineBreakMode="WordWrap" FontAttributes="Italic"
                                                       Style="{StaticResource Dim}"
                                                       IsVisible="{Binding Was, Converter={StaticResource NullToBooleanConverter}}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- My win rate playing the hero, with it and against it, over the modes and maps picked -->
            <ScrollView Grid.Row="2" IsVisible="{Binding ShowStatistics}" VerticalScrollBarVisibility="Always">
                <VerticalStackLayout BindingContext="{Binding Stats}">
                    <VerticalStackLayout x:DataType="pages:HeroStatsViewModel" Spacing="14" Padding="0,0,16,20">
                        <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="10">
                            <Label Text="Modes" FontFamily="OpenSansSemibold" Margin="0,4,0,0" />
                            <FlexLayout Grid.Column="1" Wrap="Wrap" BindableLayout.ItemsSource="{Binding Modes}"
                                        BindableLayout.ItemTemplate="{StaticResource FilterChip}" />
                            <Label Grid.Column="2" Text="{Binding ModesLabel}" Style="{StaticResource Dim}"
                                   Margin="0,4,0,0" />
                        </Grid>
                        <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="10">
                            <Label Text="Maps" FontFamily="OpenSansSemibold" Margin="0,4,0,0" />
                            <FlexLayout Grid.Column="1" Wrap="Wrap" BindableLayout.ItemsSource="{Binding Maps}"
                                        BindableLayout.ItemTemplate="{StaticResource FilterChip}" />
                            <Label Grid.Column="2" Text="{Binding MapsLabel}" Style="{StaticResource Dim}"
                                   Margin="0,4,0,0" />
                        </Grid>
                        <HorizontalStackLayout Spacing="16" Margin="74,-6,0,0">
                            <Label Text="Clear modes" TextDecorations="Underline" Style="{StaticResource Dim}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClearModesCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="Clear maps" TextDecorations="Underline" Style="{StaticResource Dim}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClearMapsCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                        <Label Text="{Binding Status}" FontSize="16"
                               IsVisible="{Binding Status, Converter={StaticResource NullToBooleanConverter}}" />

                        <!-- Playing it | With it | Against it -->
                        <HorizontalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Cards}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="pages:HeroStatsCard">
                                    <Border WidthRequest="200" Padding="16,10" StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="16" />
                                            <Label Text="{Binding Result.WinRateText}" FontSize="32"
                                                   FontFamily="OpenSansSemibold" TextColor="{Binding Result.Color}" />
                                            <Label Text="{Binding Result.Record, StringFormat='{0} (wins–losses)'}" />
                                            <Label Text="{Binding Hint}" Style="{StaticResource Dim}" FontSize="12" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>

                        <!-- Map by map: win rate (games) -->
                        <VerticalStackLayout IsVisible="{Binding HasByMap}">
                            <Grid ColumnDefinitions="220,140,140,140" Padding="0,8,0,4">
                                <Label Text="Map" FontFamily="OpenSansSemibold" />
                                <Label Grid.Column="1" Text="Playing it" FontFamily="OpenSansSemibold" />
                                <Label Grid.Column="2" Text="With it" FontFamily="OpenSansSemibold" />
                                <Label Grid.Column="3" Text="Against it" FontFamily="OpenSansSemibold" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="Gray" Margin="0,0,0,2" HorizontalOptions="Start"
                                     WidthRequest="640" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ByMap}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="pages:HeroStatsMapRow">
                                        <Grid ColumnDefinitions="220,140,140,140" Padding="0,4">
                                            <Label Text="{Binding Map}" />
                                            <Label Grid.Column="1" Text="{Binding Me.Cell}" TextColor="{Binding Me.Color}"
                                                   ToolTipProperties.Text="{Binding Me.Record}" />
                                            <Label Grid.Column="2" Text="{Binding Ally.Cell}" TextColor="{Binding Ally.Color}"
                                                   ToolTipProperties.Text="{Binding Ally.Record}" />
                                            <Label Grid.Column="3" Text="{Binding Enemy.Cell}" TextColor="{Binding Enemy.Color}"
                                                   ToolTipProperties.Text="{Binding Enemy.Record}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
