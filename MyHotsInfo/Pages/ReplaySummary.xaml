<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MyHotsInfo.Controls"
             xmlns:pages="clr-namespace:MyHotsInfo.Pages"
             x:Class="MyHotsInfo.Pages.ReplayPage" x:DataType="pages:ReplaySummaryViewModel">

    <ContentPage.Content>
        <Grid>
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.45" Radius="0.9">
                    <GradientStop Color="#2A1763" Offset="0" />
                    <GradientStop Color="#120A2C" Offset="0.7" />
                    <GradientStop Color="#0A0619" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>

            <ScrollView>
                <controls:ReplaySummaryView HorizontalOptions="Center" Margin="0,12,0,52"
                                            PlayerTapped="PlayerTapped" />
            </ScrollView>

            <Button x:Name="KeepRecordingButton"
                    Text="Keep recording"
                    IsVisible="False"
                    Clicked="KeepRecordingClicked"
                    HorizontalOptions="End" VerticalOptions="End"
                    Margin="0,0,20,20" />
        </Grid>
    </ContentPage.Content>
</ContentPage>
