<?xml version="1.0" encoding="utf-8"?>

<!-- The in-game score screen for one game; shown by the summary page and the replay list. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MyReplayLibrary.Data.Models;assembly=MyReplayLibrary"
             xmlns:utils="clr-namespace:MyHotsInfo.Utils"
             xmlns:pages="clr-namespace:MyHotsInfo.Pages"
             x:Class="MyHotsInfo.Controls.ReplaySummaryView" x:DataType="pages:ReplaySummaryViewModel">

    <ContentView.Resources>
        <ResourceDictionary>
            <utils:HeroToImageConverter x:Key="HeroToImageConverter" />

            <Color x:Key="AllyText">#8FC2FF</Color>
            <Color x:Key="AllyLevelText">#4FD3F0</Color>
            <Color x:Key="EnemyText">#FF5FA8</Color>
            <Color x:Key="EnemyLevelText">#E0558F</Color>

            <Style x:Key="StatLabel" TargetType="Label">
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="#E4DEFF" />
            </Style>

            <Style x:Key="HeaderIcon" TargetType="Image">
                <Setter Property="WidthRequest" Value="20" />
                <Setter Property="HeightRequest" Value="20" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <Style x:Key="Band" TargetType="BoxView">
                <Setter Property="Color" Value="#26000000" />
            </Style>

            <Style x:Key="TabLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="#9C92CC" />
                <Setter Property="Padding" Value="0,2,0,4" />
            </Style>

            <Style x:Key="TabUnderline" TargetType="BoxView">
                <Setter Property="HeightRequest" Value="2" />
                <Setter Property="Color" Value="#8E7CFF" />
                <Setter Property="VerticalOptions" Value="End" />
            </Style>

            <Style x:Key="TierLabel" TargetType="Label" BasedOn="{StaticResource StatLabel}">
                <Setter Property="WidthRequest" Value="78" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="#F0EBFF" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="{Binding Title}"
                   FontFamily="OpenSansSemibold" FontSize="24" FontAttributes="Bold"
                   TextColor="White" VerticalTextAlignment="Center" />
            <Label Grid.Column="1" Text="{Binding Id, StringFormat='Replay #{0}'}"
                   FontSize="10" TextColor="#8C80C0" VerticalTextAlignment="End" />
        </Grid>

        <!-- Stats | Talents, like the score screen's tabs -->
        <HorizontalStackLayout Spacing="12" Margin="2,-4,0,0">
            <Grid>
                <Label Text="Stats" Style="{StaticResource TabLabel}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Tab.ShowStats}" Value="True">
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Label.Triggers>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStatsTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView Style="{StaticResource TabUnderline}" IsVisible="{Binding Tab.ShowStats}" />
            </Grid>
            <Label Text="|" Style="{StaticResource TabLabel}" TextColor="#5A5090" />
            <Grid>
                <Label Text="Talents" Style="{StaticResource TabLabel}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Tab.ShowTalents}" Value="True">
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Label.Triggers>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTalentsTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView Style="{StaticResource TabUnderline}" IsVisible="{Binding Tab.ShowTalents}" />
            </Grid>
        </HorizontalStackLayout>

        <Border StrokeThickness="2" Stroke="#6A5CC8" Padding="18,6,18,6">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E1548" Offset="0" />
                    <GradientStop Color="#160F38" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <VerticalStackLayout Spacing="0">
                <!-- Column headers -->
                <Grid ColumnDefinitions="4,54,148,34,44,44,44,84,84,84,84,84,34" HeightRequest="30">
                    <Grid Grid.Column="4" Grid.ColumnSpan="8" ColumnDefinitions="44,44,44,84,84,84,84,84"
                          IsVisible="{Binding Tab.ShowStats}">
                        <Image Source="score_kill.png" Style="{StaticResource HeaderIcon}" ToolTipProperties.Text="Kills" />
                        <Image Grid.Column="1" Source="score_assist.png" Style="{StaticResource HeaderIcon}" ToolTipProperties.Text="Assists" />
                        <Image Grid.Column="2" Source="score_death.png" Style="{StaticResource HeaderIcon}" ToolTipProperties.Text="Deaths" />
                        <Image Grid.Column="3" Source="score_siegedamage.png" Style="{StaticResource HeaderIcon}" ToolTipProperties.Text="Siege damage" />
                        <Image Grid.Column="4" Source="score_herodamage.png" Style="{StaticResource HeaderIcon}" ToolTipProperties.Text="Hero damage" />
                        <Image Grid.Column="5" Source="score_healedandabsorbed.png" Style="{StaticResource HeaderIcon}" ToolTipProperties.Text="Healing" />
                        <Image Grid.Column="6" Source="score_selfhealingshielding.png" Style="{StaticResource HeaderIcon}" ToolTipProperties.Text="Self healing" />
                        <Image Grid.Column="7" Source="score_xpcontribution.png" Style="{StaticResource HeaderIcon}" ToolTipProperties.Text="Experience contribution" />
                    </Grid>

                    <!-- Seven 78-wide slots, as in the rows below -->
                    <HorizontalStackLayout Grid.Column="4" Grid.ColumnSpan="8" IsVisible="{Binding Tab.ShowTalents}">
                        <Label Text="1" Style="{StaticResource TierLabel}" />
                        <Label Text="4" Style="{StaticResource TierLabel}" />
                        <Label Text="7" Style="{StaticResource TierLabel}" />
                        <Label Text="10" Style="{StaticResource TierLabel}" />
                        <Label Text="13" Style="{StaticResource TierLabel}" />
                        <Label Text="16" Style="{StaticResource TierLabel}" />
                        <Label Text="20" Style="{StaticResource TierLabel}" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Players -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="2">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pages:ReplaySummaryRow">
                            <Border HeightRequest="38" StrokeThickness="1" Stroke="#9C2A5E">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#561838" Offset="0" />
                                        <GradientStop Color="#3D1230" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsAlly}" Value="True">
                                        <Setter Property="Stroke" Value="#2F6CC8" />
                                        <Setter Property="Background">
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#1D3A78" Offset="0" />
                                                <GradientStop Color="#182C5C" Offset="1" />
                                            </LinearGradientBrush>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsMe}" Value="True">
                                        <Setter Property="Stroke" Value="#77E04C" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                        <Setter Property="Background">
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#27524C" Offset="0" />
                                                <GradientStop Color="#1D3C4C" Offset="1" />
                                            </LinearGradientBrush>
                                        </Setter>
                                    </DataTrigger>
                                </Border.Triggers>

                                <!-- Keep in step with the column headers above. -->
                                <Grid ColumnDefinitions="4,54,148,34,44,44,44,84,84,84,84,84,34">
                                    <BoxView Color="#FF3D7F">
                                        <BoxView.Triggers>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding IsAlly}" Value="True">
                                                <Setter Property="Color" Value="#37C4FF" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding IsMe}" Value="True">
                                                <Setter Property="Color" Value="#8CFF3A" />
                                            </DataTrigger>
                                        </BoxView.Triggers>
                                    </BoxView>
                                    <BoxView Grid.Column="4" Grid.ColumnSpan="3" Style="{StaticResource Band}"
                                             IsVisible="{Binding Tab.ShowStats}" />
                                    <BoxView Grid.Column="9" Grid.ColumnSpan="2" Style="{StaticResource Band}"
                                             IsVisible="{Binding Tab.ShowStats}" />

                                    <Grid Grid.Column="1" IsClippedToBounds="True">
                                        <Image Source="{Binding Character.CharacterId, Converter={StaticResource HeroToImageConverter}}"
                                               Aspect="AspectFill" />
                                    </Grid>

                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Padding="6,0,0,0">
                                        <Label Text="{Binding Character.CharacterId}"
                                               FontFamily="OpenSansSemibold" FontSize="12" TextColor="#F6E7BA" />
                                        <Label FontSize="9" TextColor="#C9BEF0">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Character.Player.Name}" TextDecorations="Underline" />
                                                    <Span Text="#" TextColor="#7F74A8" />
                                                    <Span Text="{Binding Character.Player.BattleTag}" TextColor="#7F74A8" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPlayerTapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </VerticalStackLayout>

                                    <Image Grid.Column="3" Source="{Binding AwardImage}"
                                           WidthRequest="32" HeightRequest="32" />

                                    <HorizontalStackLayout Grid.Column="4" Grid.ColumnSpan="8"
                                                           IsVisible="{Binding Tab.ShowTalents}"
                                                           BindableLayout.ItemsSource="{Binding Talents}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="pages:TalentSlot">
                                                <Grid WidthRequest="78">
                                                    <Border WidthRequest="32" HeightRequest="32" StrokeThickness="1"
                                                            Stroke="#3A3170" BackgroundColor="#1A0F33" Padding="0"
                                                            ToolTipProperties.Text="{Binding ToolTip}">
                                                        <Border.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding IsPicked}" Value="True">
                                                                <Setter Property="Stroke" Value="#A9A2D8" />
                                                            </DataTrigger>
                                                        </Border.Triggers>
                                                        <Image Source="{Binding Image}" Aspect="AspectFill" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>

                                    <ContentView Grid.Column="4" Grid.ColumnSpan="8" IsVisible="{Binding Tab.ShowStats}">
                                        <Grid ColumnDefinitions="44,44,44,84,84,84,84,84"
                                              BindingContext="{Binding Character.ReplayCharacterScoreResult}"
                                              x:DataType="models:ReplayCharacterScoreResult">
                                            <Label Text="{Binding SoloKills}" Style="{StaticResource StatLabel}" />
                                            <Label Text="{Binding Assists}" Grid.Column="1" Style="{StaticResource StatLabel}" />
                                            <Label Text="{Binding Deaths}" Grid.Column="2" Style="{StaticResource StatLabel}" />
                                            <Label Text="{Binding SiegeDamage, StringFormat='{0:N0}'}" Grid.Column="3" Style="{StaticResource StatLabel}" />
                                            <Label Text="{Binding HeroDamage, StringFormat='{0:N0}'}" Grid.Column="4" Style="{StaticResource StatLabel}" />
                                            <Label Text="{Binding Healing, StringFormat='{0:N0}', TargetNullValue='-'}" Grid.Column="5" Style="{StaticResource StatLabel}" />
                                            <Label Text="{Binding SelfHealing, StringFormat='{0:0,0;;-}'}" Grid.Column="6" Style="{StaticResource StatLabel}" />
                                            <Label Text="{Binding ExperienceContribution, StringFormat='{0:N0}'}" Grid.Column="7" Style="{StaticResource StatLabel}" />
                                        </Grid>
                                    </ContentView>

                                    <Label Text="&#x2699;" Grid.Column="12" Style="{StaticResource StatLabel}" TextColor="#B8AEE8" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Kills, team level and game time -->
                <Grid ColumnDefinitions="*,165,*" HeightRequest="72" Margin="0,6,0,0">
                    <HorizontalStackLayout HorizontalOptions="End" Spacing="6">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{Binding AllyTeam.Name}" HorizontalTextAlignment="End"
                                   FontFamily="OpenSansSemibold" FontSize="20" TextColor="{StaticResource AllyText}" />
                            <Label Text="{Binding AllyTeam.Level, StringFormat='Level {0}'}" HorizontalTextAlignment="End"
                                   FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource AllyLevelText}" />
                        </VerticalStackLayout>
                        <Label Text="{Binding AllyTeam.Kills}" VerticalTextAlignment="Center"
                               FontFamily="OpenSansSemibold" FontSize="44" FontAttributes="Bold" TextColor="#E8F1FF" />
                        <Image Source="score_kills_blue.png" WidthRequest="28" HeightRequest="26" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="Game Time:" HorizontalTextAlignment="Center"
                               FontFamily="OpenSansSemibold" FontSize="17" TextColor="#B4C0F5" />
                        <Label Text="{Binding GameTime}" HorizontalTextAlignment="Center"
                               FontFamily="OpenSansSemibold" FontSize="17" TextColor="White" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Column="2" HorizontalOptions="Start" Spacing="6">
                        <Image Source="score_kills_red.png" WidthRequest="28" HeightRequest="26" VerticalOptions="Center" />
                        <Label Text="{Binding EnemyTeam.Kills}" VerticalTextAlignment="Center"
                               FontFamily="OpenSansSemibold" FontSize="44" FontAttributes="Bold" TextColor="#FF6AAE" />
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{Binding EnemyTeam.Name}"
                                   FontFamily="OpenSansSemibold" FontSize="20" TextColor="{StaticResource EnemyText}" />
                            <Label Text="{Binding EnemyTeam.Level, StringFormat='Level {0}'}"
                                   FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource EnemyLevelText}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
